# Database credentials
db_username = "postgres"
db_password = "change-me-to-a-secure-password"

# AWS Region
aws_region = "us-east-1"

# Project name
project_name = "weiqi"

# Environment
environment = "dev"

# SSH Public Key (if not using default ~/.ssh/id_rsa.pub)
# ssh_public_key = "ssh-rsa AAAA..."

# Docker image
docker_image = "your-registry/weiqi-backend:latest"

# Supabase JWT Secret
supabase_jwt_secret = "your-supabase-jwt-secret" 